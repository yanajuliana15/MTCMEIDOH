# Database URL
# Untuk PRODUCTION di Vercel: pakai Neon PostgreSQL (lihat DEPLOYMENT.md)
# Format: postgresql://user:password@ep-HOSTNAME-pooler.REGION.aws.neon.tech/dbname?sslmode=require
#
# Untuk DEV LOKAL: 
#   Opsi 1 (Recommended): Buat database Neon free tier, pakai connection string di sini
#   Opsi 2: Install PostgreSQL lokal, pakai postgresql://user:pass@localhost:5432/dbname
#
# Sementara untuk dev cepat, pakai SQLite (ubah provider di prisma/schema.prisma ke "sqlite")
# DATABASE_URL="file:./dev.db"

DATABASE_URL=file:/home/z/my-project/db/custom.db
